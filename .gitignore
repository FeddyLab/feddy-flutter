# Dart / Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Library packages should not commit pubspec.lock — host apps resolve
# their own version constraints. The example/ app under this repo is
# allowed to commit its own pubspec.lock (carved out below).
pubspec.lock
!example/pubspec.lock

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# macOS
.DS_Store

# Auto-generated platform shells (regenerated by `flutter create`)
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
android/.gradle/
android/local.properties
android/build/
android/app/build/

# Task / planning docs are never committed to public SDK repos —
# they live in the local-only feedback-platform/docs/tasks/ tree.
docs/

# Env / secrets
.env
.env.local
.env.*.local
